BASE44_APP_ID=69de7e170e733e9653c3bbbd
BASE44_API_BASE=https://peak-hoqs-lab.base44.app/api
BASE44_API_KEY=replace-after-rotating-in-base44
MISSION_CONTROL_HOST=127.0.0.1
MISSION_CONTROL_PORT=8788
MISSION_CONTROL_HUB_URL=http://127.0.0.1:8788
# If CANONICAL Operator Dashboard keeps 8787, Mission Control hub uses 8788 (see runbooks/hub-deployment-windows.md).
MISSION_CONTROL_TOKEN=replace-with-a-generated-mission-control-token
# Optional fixed data directory (defaults to .mission-control/data under cwd)
# MISSION_CONTROL_DATA_DIR=C:\path\to\device-mission-control\.mission-control\data

# GitHub Council Bridge (read-only PR intake)
# Option A: explicit repo list
# MISSION_CONTROL_GITHUB_REPOS=owner/repo,owner/other-repo
# Option B: org-wide discovery (recommended for all projects in a namespace)
MISSION_CONTROL_GITHUB_ORG=timmilkewicz-collab,tbm898-source,timgordianknot
# Exclude deprecated or non-project repos from org discovery
MISSION_CONTROL_GITHUB_EXCLUDE_REPOS=timmilkewicz-collab/Meshroom
MISSION_CONTROL_GITHUB_TOKEN=replace-with-github-pat-or-fine-grained-token
# Use GitHub CLI token when it has broader repo access than the PAT above
# MISSION_CONTROL_GITHUB_PREFER_GH_CLI=1
# MISSION_CONTROL_GITHUB_MAX_PRS=5
# MISSION_CONTROL_GITHUB_INCLUDE_FORKS=0
# MISSION_CONTROL_GITHUB_INCLUDE_ARCHIVED=0
# MISSION_CONTROL_GITHUB_API_BASE=https://api.github.com

# ProLiant / Goliath Linux SSH lane (verify:proliant-ssh, collect:proliant)
# MISSION_CONTROL_PROLIANT_SSH_HOST=192.168.0.174
# MISSION_CONTROL_PROLIANT_SSH_PORT=22
# MISSION_CONTROL_PROLIANT_SSH_USER=macro
# MISSION_CONTROL_PROLIANT_SSH_KEY_PATH=C:\Users\you\.ssh\id_ed25519
# MISSION_CONTROL_PROLIANT_SSH_PASSWORD=replace-for-one-off-password-auth
